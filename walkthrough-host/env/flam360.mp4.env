# Golden test clip for Walkthrough Host (copy and edit paths, or source as-is after editing).
# Usage:
#   set -a && source walkthrough-host/env/flam360.mp4.env && set +a
#   bash walkthrough-host/scripts/upload_test_video.sh

LYRA_WALKTHROUGH_TEST_VIDEO=/path/to/your/walkthrough.mp4
LYRA_WALKTHROUGH_API=http://127.0.0.1:8000

# Optional: SSH to Vast (tunnel API to localhost)
# LYRA_WALKTHROUGH_SSH=ssh -p PORT root@HOST -L 8000:localhost:8000

# Optional: local Lyra-2 root when running CLI outside Docker
# LYRA2_ROOT=/path/to/lyra/Lyra-2
