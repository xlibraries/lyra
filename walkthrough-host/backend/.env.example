# Path to Lyra-2 in this repo (Linux GPU machine)
LYRA2_ROOT=/path/to/lyra/Lyra-2

# Job storage (default: walkthrough-host/data)
# DATA_DIR=/path/to/walkthrough-host/data

# Optional: conda env python that has Lyra deps
# PYTHON_BIN=/path/to/conda/envs/lyra2/bin/python

# Optional: DA3 checkpoint (see Lyra-2 README)
# DA3_MODEL_PATH=/path/to/Lyra-2/checkpoints/recon/model.pt

# Cap frames from long videos (0 = no cap)
# MAX_FRAMES=300
# DA3 views for reconstruction (lower = less VRAM; default 48)
# DA3_MAX_FRAMES=48
# Cap DA3 processing resolution short side. Default in code is 0 (uncapped — no --max_resolution).
# If you OOM after VIPE, set e.g. DA3_MAX_RESOLUTION=720 or 640.
# DA3_MAX_RESOLUTION=720

# Frames per batch when writing gs_trajectory.mp4 (lower = less peak VRAM during encode)
# RENDER_VIDEO_GPU_BATCH=16

# UPLOAD_MAX_MB=2048

# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional: path to `frontend/dist` for same-origin UI (see README)
# LYRA_WALKTHROUGH_STATIC=/path/to/walkthrough-host/frontend/dist

# Agent / dev fixture (not read by Settings — use with scripts/upload_test_video.sh)
# See walkthrough-host/env/flam360.mp4.env
